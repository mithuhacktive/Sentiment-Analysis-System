# ── Core ──────────────────────────────────────────────
SENTIGUARD_ENV=development
SENTIGUARD_DEBUG=false
SENTIGUARD_OFFLINE=false

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sentiguard.db

# ── Model ─────────────────────────────────────────────
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
MODEL_DEVICE=cpu
MODEL_BATCH_SIZE=16
MODEL_MAX_LENGTH=512

# ── Retrieval budget ──────────────────────────────────
MAX_SOURCES=8
MAX_REVIEWS_PER_SOURCE=50
MAX_TOTAL_REVIEWS=250
REQUEST_TIMEOUT_SECONDS=20

# ── Cache ─────────────────────────────────────────────
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=512

# ── Optional external APIs ────────────────────────────
SERPAPI_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentiguard/1.0

# ── Thresholds ────────────────────────────────────────
MIN_REVIEWS_FOR_CONCLUSION=3
DUPLICATE_SIMILARITY_THRESHOLD=0.85
SPAM_SCORE_THRESHOLD=0.7
LOW_CONFIDENCE_THRESHOLD=0.55
HIGH_CONFIDENCE_THRESHOLD=0.80